<!DOCTYPE html>
<html>
  <head>
    <base target="_top">
    <!-- BLOQUEIO DE ZOOM PARA CELULARES -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- EXPORTAÇÃO EXCEL E PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>

    <!-- FAVICON: Logo na aba do navegador -->
    <link rel="icon" type="image/png" href="/images/logo_colorido.png">
    
    <style>
      /* PADRÃO GLOBAL: Nomes e Textos */
      .texto-fluido {
          word-break: normal !important;
          overflow-wrap: normal !important;
          hyphens: none !important;
          white-space: normal !important;
          font-size: clamp(0.7rem, 2.5vw, 0.9rem) !important;
          line-height: 1.2 !important;
      }

      /* PADRÃO GLOBAL: Números e Quantidades */
      .numero-fluido {
          white-space: nowrap !important;
          word-break: keep-all !important;
          overflow-wrap: normal !important;
          font-size: clamp(0.65rem, 3vw, 1.1rem) !important; 
      }

      :root {
        /* 1. ESTRUTURA E FUNDO (Padrão Catálogo SEAP) */
        --bg-color: #f8fafc; 
        --card-bg: #ffffff; 
        --sidebar-bg: #001E7A;
        
        /* 2. TEXTOS PADRÃO */
        --text-main: #1e293b; 
        --text-muted: #64748b; 
        
        /* 3. CORES DA MARCA (Azul e Laranja SEAP) */
        --accent: #001E7A; 
        --accent-dark: #001557;
        --accent-gradient: #001E7A;
        --accent-light: #e0e7ff;
        --accent-orange: #E89E37;
        
        /* 4. BORDAS E SOMBRAS */
        --border-color: #e2e8f0; 
        --input-bg: #f1f5f9;
        --shadow: 0 2px 5px rgba(0,0,0,0.05);
        
        /* 5. CORES DE STATUS E ALERTAS */
        --success: #1b5e20; 
        --success-bg: #e8f5e9;
        --warning: #e65100; 
        --warning-bg: #fff3e0;
        --danger: #b71c1c; 
        --danger-bg: #ffebee;
        --neutral: #424242; 
        --neutral-bg: #f5f5f5;
        
        /* 6. TABELAS E ELEMENTOS EXTRAS */
        --table-head-bg: #f8fafd; 
        --table-row-hover: #fcfdfe;
        --acc-bg: #fcfdfe; 
        --flash-bg: #ffffff; 
        --flash-border: #455a64;
      }

      body.dark-mode {
        --bg-color: #121416; --card-bg: #1c2126; --sidebar-bg: #1c2126;
        --text-main: #f0f2f5; --text-muted: #a0abb5;
        --accent: #b0bec5; --accent-dark: #78909c;
        --accent-gradient: linear-gradient(135deg, var(--accent) 0%, var(--accent-dark) 100%);
        --accent-light: #23292e;
        --border-color: #2a3138; --input-bg: #23292e;
        --shadow: 0 10px 30px rgba(0,0,0,0.3);
        --success-bg: rgba(46, 125, 50, 0.2);
        --warning-bg: rgba(255, 152, 0, 0.1);
        --danger-bg: rgba(198, 40, 40, 0.2);
        --table-head-bg: #23292e; --table-row-hover: #2a3138;
        --acc-bg: #23292e; --flash-bg: #1c2126; --flash-border: #78909c;
      }

      html { font-size: clamp(12px, 1.2vw + 8px, 16px) !important; }
      html, body { 
        background-color: var(--bg-color); color: var(--text-main); 
        font-family: 'Poppins', sans-serif; transition: background-color 0.3s, color 0.3s; 
        max-width: 100vw; overflow-x: hidden; margin: 0; padding: 0;
      }
      * { box-sizing: border-box; }

      /* FORÇAR PADRÃO CATÁLOGO */
      .top-bar, .slide-header, .chart-card, .new-card, .flash-box {
          border-radius: 8px !important;
          border: 1px solid var(--border-color) !important;
          box-shadow: var(--shadow) !important;
      }
      button, .theme-btn, .drop-btn, .fc-button, .summary-card, #calendar-wrapper, .modal-card {
          border-radius: 8px !important; transition: all 0.2s ease-in-out !important;
      }

      /* LOADER */
      #loader { position: fixed; inset: 0; background: var(--bg-color); z-index: 9999; display: flex; flex-direction: column; align-items: center; justify-content: center; transition: opacity 0.5s ease-out; overflow: hidden; }
      .loader-text { font-size: 1.3rem; color: var(--text-muted); font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase; position: relative; z-index: 1; }
      body.loaded #loader { opacity: 0; pointer-events: none; }
      .logo-loader-container { position: relative; width: 140px; height: 140px; }
      .logo-base { position: absolute; width: 100%; height: 100%; object-fit: contain; opacity: 0.15; filter: grayscale(100%); }
      .logo-fill { position: absolute; width: 100%; height: 100%; object-fit: contain; animation: fillLogo 1.5s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate; clip-path: inset(100% 0 0 0); }
      @keyframes fillLogo { 0% { clip-path: inset(100% 0 0 0); } 100% { clip-path: inset(0 0 0 0); } }

      /* LAYOUT & SIDEBAR */
      .layout-wrapper { display: flex; min-height: 100vh; position: relative; width: 100%; max-width: 100vw; overflow-x: hidden; }
      .sidebar-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); z-index: 90; backdrop-filter: blur(2px); }
      .sidebar-overlay.show { display: block; }
      .sidebar { width: 320px; position: fixed; left: 0; top: 0; bottom: 0; background: var(--sidebar-bg); border-right: 1px solid var(--border-color); display: flex; flex-direction: column; align-items: flex-start; padding-top: 25px; gap: 10px; z-index: 1000; overflow-x: hidden; white-space: nowrap; transition: left 0.3s; }
      
      .nav-item { width: calc(100% - 40px); margin: 0 20px; height: 54px; border-radius: 8px; display: flex; align-items: center; justify-content: flex-start; padding-left: 15px; color: #ffffff; cursor: pointer; transition: 0.2s all ease; border: none; text-decoration: none; }
      .nav-item:hover { background: rgba(255, 255, 255, 0.1); color: #ffffff; }
      .nav-item.active { background: #ffffff !important; color: var(--sidebar-bg) !important; box-shadow: none !important; border-left: none; }
      .nav-item .material-icons { font-size: 28px; min-width: 34px; } 
      .nav-text { margin-left: 15px; font-size: 1.05rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.3px; }

      .main-content { flex: 1; overflow-y: auto; padding: 30px; position: relative; margin-left: 320px; width: calc(100vw - 320px); transition: margin-left 0.3s, width 0.3s; overflow-x: hidden; }
      
      /* TOP BAR */
      .top-bar { background: var(--card-bg); padding: 15px 25px; margin-bottom: 30px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 15px; }
      .title-box { display: flex; align-items: center; gap: 10px; }
      .title-box h1 { margin: 0; font-size: 1.6rem; font-weight: 700; color: var(--text-main); text-transform: uppercase; } 
      #mobile-menu-btn { display: none; background: transparent; border: 1px solid var(--border-color); color: var(--text-main); border-radius: 12px; padding: 5px 10px; cursor: pointer; }
      
      .date-filters { display: flex; gap: 10px; background: var(--input-bg); padding: 10px 15px; border-radius: 14px; border: 1px solid transparent; } 
      .date-filters input { border: none; background: transparent; color: var(--text-main); outline: none; cursor: pointer; font-family: inherit; font-size: 0.95rem; font-weight: 500; width: 130px; } 
      
      .theme-btn { cursor: pointer; background: transparent; border: 1px solid var(--border-color); padding: 0.8rem 1.2rem !important; color: var(--text-muted); display: flex; align-items: center; justify-content: center; }
      .theme-btn:hover { background: var(--accent) !important; color: white !important; }
      .clock-display { font-size: 1.2rem; font-weight: 700; color: var(--accent); background: var(--input-bg); padding: 8px 16px; border-radius: 14px; display: flex; align-items: center; gap: 8px; }

      /* ESTRUTURA COMPARTILHADA DOS SLIDES */
      .slide { display: none; animation: fadeEffect 0.4s ease; }
      .slide.active { display: block; }
      @keyframes fadeEffect { from {opacity: 0; transform: translateY(10px);} to {opacity: 1; transform: translateY(0);} }

      .slide-header { background: var(--card-bg); padding: 20px 25px; margin-bottom: 25px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; }
      .slide-title { font-size: 1.4rem; color: var(--text-main); font-weight: 700; display: flex; align-items: center; gap: 12px; text-transform: uppercase; } 
      .slide-title .material-icons { color: var(--accent); font-size: 28px; }

      .filter-wrapper { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; width: 100%; justify-content: flex-end; }
      .filter-wrapper select, .filter-wrapper input { padding: 12px 16px; background-color: var(--input-bg); color: var(--text-main); border: 1px solid transparent; border-radius: 12px; min-width: 160px; font-family: inherit; font-size: 0.95rem; font-weight: 500; outline: none; flex: 1; transition: 0.2s; }
      .filter-wrapper select:focus, .filter-wrapper input:focus { border-color: var(--accent); }
      
      .chart-grid { display: grid; gap: 30px; }
      .grid-2 { grid-template-columns: 2fr 1fr; }
      .chart-card { background: var(--card-bg); overflow: hidden; display: flex; flex-direction: column; width: 100%; }

      /* TABELAS E BADGES COMPARTILHADOS */
      .stock-table-container { height: 500px; overflow-y: auto; overflow-x: auto; width: 100%; box-sizing: border-box; }
      .stock-table { width: 100%; border-collapse: separate; border-spacing: 0; text-align: left; }
      .stock-table th { background: var(--card-bg); color: var(--text-muted); padding: 15px; position: sticky; top: 0; z-index: 1; border-bottom: 1px solid var(--border-color); font-weight: 600; font-size: 0.85rem; text-transform: uppercase; }
      .stock-table td { padding: 12px 15px; border-bottom: 1px solid var(--border-color); color: var(--text-main); font-size: clamp(0.75rem, 1.5vw, 0.95rem); font-weight: 500; } 
      .stock-table tr:hover td { background-color: var(--table-row-hover); }

      .badge-stock { padding: 6px 14px; border-radius: 20px; font-weight: 700; font-size: 0.95rem; background: var(--input-bg); border: 1px solid transparent; color: var(--text-main); }
      .bs-pos { background: var(--success-bg); color: var(--success); }
      .bs-neg { background: var(--danger-bg); color: var(--danger); }

      .status-text { font-weight: 600; font-size: 0.8rem; text-transform: uppercase; padding: 6px 12px; border-radius: 8px; letter-spacing: 0.5px; }
      .nc-pill.ok, .st-ok { background: var(--success-bg); color: var(--success); border: 1px solid currentColor !important; font-weight: 800; }
      .nc-pill.fail, .st-bad { background: var(--danger-bg); color: var(--danger); border: 1px solid currentColor !important; font-weight: 800; }
      .nc-pill.neutral, .st-none { background: var(--neutral-bg); color: var(--text-muted); border: 1px solid var(--border-color) !important; font-weight: 600; }

      .origem-badge { display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; border: 1px solid transparent; }
      .ob-plan { background-color: #fff3cd; color: #856404; }
      .ob-bd { background-color: #e3f2fd; color: #0d47a1; }
      .subgroup-text { font-size: 0.75rem; color: var(--text-muted); font-weight: 500; display: block; border-top: 1px dashed var(--border-color); padding-top: 4px; margin-top: 4px; }

      /* DROPDOWNS COMPARTILHADOS */
      .custom-dropdown { position: relative; display: inline-block; }
      .drop-btn { background: var(--input-bg); border: 1px solid transparent; padding: 12px 16px; cursor: pointer; font-size: 0.95rem; color: var(--text-main); font-weight: 500; display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; font-family: inherit; }
      .drop-btn:hover { border-color: var(--accent); }
      .dropdown-content { display: none; position: absolute; top: 110%; left: 0; background-color: var(--card-bg); min-width: 100%; width: max-content; max-width: 90vw !important; box-shadow: var(--shadow); z-index: 1000; border: 1px solid var(--border-color); border-radius: 16px; padding: 10px; overflow-y: auto; }
      .dropdown-content.show { display: block; animation: fadeEffect 0.2s; }
      .checkbox-item { padding: 8px 10px; border-radius: 8px; transition: 0.2s; }
      .checkbox-item:hover { background-color: var(--input-bg); }

      @media (max-width: 1199px) { 
          .sidebar { left: -320px; }
          .sidebar.open { left: 0; }
          .main-content { margin-left: 0; width: 100vw; max-width: 100vw; padding: 15px; }
          #mobile-menu-btn { display: block; }
          .clock-display { display: none; } 
          
          .top-bar { padding: 20px; flex-direction: column; align-items: flex-start; }
          .top-bar > div:last-child { width: 100%; flex-wrap: wrap !important; justify-content: space-between; gap: 12px !important; }
          .date-filters { flex: 1; width: 100% !important; order: -1; justify-content: space-between; }
          .date-filters input { width: 48%; text-align: center; }

          .slide-header { padding: 20px; }
          .slide-title { font-size: 1.2rem; }
          .slide-title .material-icons { font-size: 24px; }

          .chart-grid.grid-2 { grid-template-columns: 1fr; }
          .chart-card { max-width: 100%; overflow: hidden; box-sizing: border-box; }

          .stock-table-container { border: none !important; background: transparent; height: auto !important; max-height: none !important; overflow-x: hidden !important; }
          .stock-table { display: block; width: 100%; border: none !important; box-sizing: border-box; }
          .stock-table thead { display: none; }
          .stock-table tbody tr { display: flex; flex-direction: column; margin-bottom: 15px; background: var(--card-bg); border: none; border-radius: 16px; box-shadow: var(--shadow); padding: 0; width: 100%; max-width: 100%; box-sizing: border-box; }
          .stock-table tbody td { display: flex; justify-content: space-between; align-items: center; padding: 10px 15px !important; border-bottom: 1px solid var(--border-color) !important; border-top: none; gap: 10px; font-size: clamp(0.75rem, 2.5vw, 0.85rem); width: 100%; box-sizing: border-box; text-align: right; }
          .stock-table tbody td:last-child { border-bottom: none !important; }
          .stock-table tbody td > div { font-size: clamp(0.85rem, 1.8vw, 1.1rem) !important; }

          .dropdown-content { position: fixed !important; top: 50% !important; left: 50% !important; transform: translate(-50%, -50%) !important; width: 92vw !important; max-width: none !important; max-height: 75vh !important; box-shadow: 0 10px 50px rgba(0,0,0,0.6) !important; border-radius: 12px !important; z-index: 9999 !important; }
      }
    </style>
  </head>
  <body>

    <div id="loader">
      <div class="logo-loader-container">
        <img src="/images/logo_colorido.png" alt="Logo Fundo" class="logo-base">
        <img src="/images/logo_colorido.png" alt="Logo Animada" class="logo-fill">
      </div>
      <div class="loader-text" style="margin-top: 20px;">CARREGANDO DADOS...</div>
    </div>

    <div class="layout-wrapper">
      <div class="sidebar-overlay" id="sidebar-overlay" onclick="toggleSidebar()"></div>
      
      <div class="sidebar" id="sidebar">
        <div style="width: 100%; display: flex; justify-content: center; align-items: center; padding-bottom: 20px; margin-bottom: 5px; border-bottom: 1px solid var(--border-color);">
           <img src="/images/logo.png" alt="Logo" style="height: 100px; max-width: 85%; object-fit: contain;">
        </div>

        <div class="nav-item active" onclick="currentSlide(1)" title="Apresentação Geral"><span class="material-icons">pie_chart</span><span class="nav-text">APRESENTAÇÃO</span></div>
        <div class="nav-item" onclick="currentSlide(2)" title="Diário de Produção"><span class="material-icons">dashboard</span><span class="nav-text">DIÁRIO</span></div>
        <div class="nav-item" onclick="currentSlide(3)" title="Estoque Geral"><span class="material-icons">warehouse</span><span class="nav-text">ESTOQUE</span></div>
        <div class="nav-item" onclick="currentSlide(4)" title="Análise do Item"><span class="material-icons">query_stats</span><span class="nav-text">ANÁLISE</span></div>
        <div class="nav-item" onclick="currentSlide(5)" title="Metas Detalhadas"><span class="material-icons">track_changes</span><span class="nav-text">METAS</span></div>
        <div class="nav-item" onclick="currentSlide(6)" title="Controle de Processos"><span class="material-icons">assignment</span><span class="nav-text">PROCESSOS</span></div>
        <div class="nav-item" onclick="currentSlide(7)" title="Cronograma"><span class="material-icons">calendar_month</span><span class="nav-text">CRONOGRAMA</span></div>
        <div class="nav-item" onclick="currentSlide(8)" title="Produção por Oficina"><span class="material-icons">stacked_line_chart</span><span class="nav-text">OFICINAS</span></div>
       
        <a href="https://maroon-kingfisher-471984.hostingersite.com/" class="nav-item" title="Acessar Sistema">
            <span class="material-icons">login</span><span class="nav-text">ACESSAR SISTEMA</span>
        </a>
      </div>
    
      <div>
        <div class="main-content">
          <div class="top-bar">
            <div class="title-box">
              <button id="mobile-menu-btn" onclick="toggleSidebar()"><i class="material-icons">menu</i></button>
              <h1>DASHBOARD - SERRALHERIA</h1>
            </div>
            <div style="display:flex; gap:15px; align-items:center; width: 100%; justify-content: flex-end;">
              <button class="theme-btn" onclick="refreshDashboard()" title="Atualizar Dados" style="font-weight: 700; color: var(--accent);"><span class="material-icons" style="margin-right: 5px;">sync</span> ATUALIZAR</button>
              <div class="date-filters"><input type="date" id="dateStart" onchange="updateAll()"><input type="date" id="dateEnd" onchange="updateAll()"></div>
              <div class="clock-display" title="Hora atual"><span class="material-icons" style="font-size:22px;">schedule</span><span id="realtimeClock" style="font-variant-numeric: tabular-nums; min-width: 80px; text-align: center; display: inline-block;">--:--:--</span></div>
              <button class="theme-btn" onclick="toggleTheme()" title="Alternar Modo Noturno"><span class="material-icons" id="themeIcon">dark_mode</span></button>
            </div>
          </div>

          <!-- TODAS AS PÁGINAS SEPARADAS EM PARTIALS -->
          <%- include('partials/apresentacao') %>
          <%- include('partials/diario') %>
          <%- include('partials/estoque') %>
          <%- include('partials/analise') %>
          <%- include('partials/metas') %>
          <%- include('partials/processos') %>
          <%- include('partials/cronograma') %>
          <%- include('partials/producao_oficina') %>

        </div>
      </div>
    </div>
    
    <script>
      let BACKEND_DATA = null;
      let rawData = []; 
      let groupedData = []; 
      let slideIndex = 1; 
      let isDarkMode = false;

      let GOAL_RULES = [
        { name: "CJ. ALUNO", keywords: ["ALUNO", "CJ ALUNO"], target: 200, type: "day", label: "200/dia" },
        { name: "LONGARINA", keywords: ["LONGARINA"], target: 75, type: "week", label: "75/sem" }, 
        { name: "CJ. REFEITÓRIO", keywords: ["REFEITORIO", "REFEITÓRIO"], target: 75, type: "week", label: "75/sem" },
        { name: "CADEIRA FIXA", keywords: ["CADEIRA FIXA", "CAD. FIXA"], target: 400, type: "week", label: "400/sem" }, 
        { name: "CJ. PROFESSOR", keywords: ["PROFESSOR"], target: 75, type: "week", label: "75/sem" }, 
        { name: "CARTEIRA ESCOLAR", keywords: ["CARTEIRA"], target: 300, type: "day", label: "300/dia" },
        { name: "CADEIRA GIRATÓRIA", keywords: ["GIRATORIA", "GIRATÓRIA"], target: 30, type: "day", label: "30/dia" },
        { name: "CADEIRA OTELLO", keywords: ["OTELLO"], target: 30, type: "day", label: "30/dia" }
      ];

      google.charts.load('current', {'packages':['corechart', 'bar']});
      google.charts.setOnLoadCallback(fetchDataAndInit);

      window.toggleSidebar = function() {
          const sb = document.querySelector('.sidebar');
          const over = document.getElementById('sidebar-overlay');
          if(sb.classList.contains('open')) {
              sb.classList.remove('open');
              over.classList.remove('show');
          } else {
              sb.classList.add('open');
              over.classList.add('show');
          }
      };

      function startClock() { 
          setInterval(() => { document.getElementById('realtimeClock').innerText = new Date().toLocaleTimeString('pt-BR'); }, 1000); 
          document.getElementById('realtimeClock').innerText = new Date().toLocaleTimeString('pt-BR'); 
      }
      
      function refreshDashboard() { window.location.href = '/?refresh=true'; }

      function fetchDataAndInit() {
        startClock(); 
        
        const urlParams = new URLSearchParams(window.location.search);
        const forceRefresh = urlParams.get('refresh') === 'true';
        const apiEndpoint = forceRefresh ? '/api/data?refresh=true' : '/api/data';

        fetch(apiEndpoint)
          .then(res => res.json())
          .then(data => {
              BACKEND_DATA = data;
              rawData = BACKEND_DATA.producao || [];
              rawData.forEach(r => r.dateObj = parseDate(r.data));
              
              const dbProds = BACKEND_DATA.produtosDb || [];
              dbProds.forEach(p => {
                  if (!p.nome) return;
                  const nm = p.nome.toUpperCase();
                  const targetDia = parseFloat(p.meta_diaria) || parseFloat(p.meta) || 0;
                  const targetSem = parseFloat(p.meta_semanal) || 0;

                  let target = 0; let type = 'day'; let label = 'SEM META';
                  if (targetDia > 0) { target = targetDia; type = 'day'; label = `${target}/dia`; }
                  else if (targetSem > 0) { target = targetSem; type = 'week'; label = `${target}/sem`; }

                  const extRule = GOAL_RULES.find(r => r.name === nm || r.keywords.some(k => nm.includes(k)));
                  if (extRule) {
                      if (target > 0) { extRule.target = target; extRule.type = type; extRule.label = label; }
                  } else {
                      GOAL_RULES.push({ name: nm, keywords: [nm], target: target, type: type, label: label });
                  }
              });

              processGroupedData(); 
              populateFilters(); 
              document.body.classList.add('loaded');
              
              setTimeout(() => { const l = document.getElementById('loader'); if(l) l.style.display = 'none'; }, 500);
              
              // Aqui forçamos a limpeza e mostramos a apresentação por defeito na primeira carga:
              currentSlide(1); 

              if(typeof receiveProcessosData === 'function') {
                  receiveProcessosData(JSON.stringify(BACKEND_DATA.processos || []));
              }

              if (forceRefresh) {
                  window.history.replaceState({}, document.title, "/");
              }
          })
          .catch(err => {
              console.error(err);
              document.getElementById('loader').innerHTML = '<div style="color:var(--danger); font-size:20px; font-weight:bold; text-align:center;">ERRO AO CARREGAR DADOS<br><span style="font-size:14px; font-weight:normal;">Atualize a página e tente novamente.</span></div>';
          });
      }

      function formatSubgroups(subObj) {
          if (!subObj || typeof subObj !== 'object') return '';
          const entries = Object.entries(subObj).filter(([k,v]) => Number(v) !== 0);
          if (entries.length === 0) return '';
          return entries.map(([k,v]) => `${k}:${v}`).join(' | ');
      }

      function sumSubgroups(target, source) {
          if(!source) return;
          Object.keys(source).forEach(k => { target[k] = (target[k] || 0) + Number(source[k]); });
      }

      function normalizeItemName(name) {
          if (!name) return "";
          const upper = name.toString().toUpperCase().trim();
          if (upper.includes("CADEIRA FIXA EM POLIPROPILENO")) return "CADEIRA FIXA EM POLIPROPILENO";
          if (upper.includes("CADEIRA GIRATÓRIA ESPALDAR")) return "CADEIRA GIRATÓRIA ESPALDAR";
          if (upper.includes("CARTEIRA ESCOLAR")) return "CARTEIRA ESCOLAR";
          if (upper.includes("LONGARINA EM POLIPROPILENO DE 3 LUGARES")) return "LONGARINA EM POLIPROPILENO DE 3 LUGARES";
          return upper;
      }

      function processGroupedData() {
          const map = {};
          rawData.forEach(row => {
              const normItem = normalizeItemName(row.item);
              const key = `${row.data}|${row.oficina}|${normItem}`;
              if (!map[key]) {
                  map[key] = {
                      data: row.data, dateObj: row.dateObj, oficina: row.oficina, item: normItem,
                      internos: 0, producao: 0, saida: 0, producaoDia: 0, estoqueDia: 0, estoqueGeral: row.estoqueGeral, 
                      observacoes: "", justificativa: "", destino: "", horarios: "", origemTag: row.origem,
                      subgrupos_producao: {}, subgrupos_saida: {}
                  };
              }
              map[key].producao += row.producao; map[key].saida += row.saida;
              map[key].producaoDia += row.producaoDia; map[key].estoqueDia += row.estoqueDia; 
              map[key].internos = Math.max(map[key].internos, row.internos);
              
              sumSubgroups(map[key].subgrupos_producao, row.subgrupos_producao);
              sumSubgroups(map[key].subgrupos_saida, row.subgrupos_saida);

              if (row.origem === "BANCO") map[key].origemTag = "BANCO";
              if (row.observacoes && row.observacoes.trim() !== "") map[key].observacoes += (map[key].observacoes ? " | " : "") + row.observacoes;
              if (row.justificativa && row.justificativa.trim() !== "") map[key].justificativa += (map[key].justificativa ? " | " : "") + row.justificativa;
              if (row.destino && row.destino.trim() !== "") map[key].destino += (map[key].destino ? " | " : "") + row.destino;
              if (row.horarios && row.horarios.trim() !== "") map[key].horarios += (map[key].horarios ? " | " : "") + row.horarios;
          });
          groupedData = Object.values(map);
      }

      function populateFilters() {
        const oficinasGroup = [...new Set(groupedData.map(r => r.oficina))].filter(Boolean).sort();
        const itensGroup = [...new Set([
            ...groupedData.map(r => r.item.toUpperCase()), 
            ...GOAL_RULES.map(r => r.name.toUpperCase())
        ])].filter(Boolean).sort();
        
        if (typeof initSlide1Filters === 'function') initSlide1Filters(oficinasGroup, itensGroup);
        if (typeof initSlide2Filters === 'function') initSlide2Filters(oficinasGroup);
        if (typeof initSlide3Filters === 'function') initSlide3Filters(itensGroup);
        if (typeof initSlide7Filters === 'function') initSlide7Filters();
      }

      function updateAll() { refreshCurrentSlide(); }

      function toggleTheme() {
        isDarkMode = !isDarkMode;
        const body = document.body; const icon = document.getElementById('themeIcon');
        if (isDarkMode) { body.classList.add('dark-mode'); icon.innerText = 'light_mode'; } else { body.classList.remove('dark-mode'); icon.innerText = 'dark_mode'; }
        updateAll();
      }

      function getChartOptions() {
        const tc = isDarkMode ? '#ffffff' : '#2b3641'; 
        const gc = isDarkMode ? '#37474f' : '#e0e0e0';
        const numColor = isDarkMode ? '#ffb300' : '#d35400'; 
        const aura = isDarkMode ? '#1c2126' : '#ffffff';

        return { 
          backgroundColor: { fill: 'transparent' }, 
          titleTextStyle: { color: tc, fontSize: 18, fontName: 'Poppins', bold: true }, 
          hAxis: { 
            textStyle: { color: tc, fontName: 'Poppins', bold: true, fontSize: 12 }, 
            gridlines: { color: gc, count: -1 }, 
            slantedText: true, slantedTextAngle: 45
          }, 
          vAxis: { 
            textStyle: { color: tc, fontName: 'Poppins', bold: true, fontSize: 12 }, 
            gridlines: { color: gc, minSpacing: 40 },
            minValue: 0, 
            viewWindow: { min: 0 }
          }, 
          legend: { 
            textStyle: { color: tc, fontName: 'Poppins', bold: true, fontSize: 13 }, 
            position: 'top', 
            alignment: 'center' 
          }, 
          annotations: { 
            textStyle: { color: numColor, fontSize: 15, fontName: 'Poppins', bold: true, auraColor: aura }, 
            alwaysOutside: true, 
            stem: { color: 'transparent' } 
          }, 
          chartArea: {width: '85%', height: '65%'},
          bar: { groupWidth: '65%' }, 
          animation: { startup: true, duration: 800, easing: 'out' } 
        };
      }

      function currentSlide(n) { 
          document.querySelectorAll('.slide').forEach(s => s.style.display = 'none');
          showSlides(slideIndex = n); 
      }
      
      function showSlides(n) {
        let slides = Array.from(document.getElementsByClassName("slide")); 
        let navItems = document.getElementsByClassName("nav-item");
        
        if (n > slides.length) slideIndex = 1; 
        if (n < 1) slideIndex = slides.length;
        
        slides.forEach(s => { s.style.display = "none"; s.classList.remove("active"); });
        Array.from(navItems).forEach(ni => ni.classList.remove("active"));
        
        const targetSlide = slides[slideIndex - 1]; 
        if (targetSlide) {
            targetSlide.style.display = "block";
            setTimeout(() => targetSlide.classList.add("active"), 10); 
        }
        if(navItems[slideIndex-1]) navItems[slideIndex-1].classList.add("active");
        
        if (window.innerWidth <= 1199) {
            document.querySelector('.sidebar').classList.remove('open');
            document.getElementById('sidebar-overlay').classList.remove('show');
        }

        refreshCurrentSlide();
      }

      function refreshCurrentSlide() {
        if (slideIndex === 1 && typeof renderSlideApresentacao === 'function') { setTimeout(() => { renderSlideApresentacao(); }, 100); }
        if (slideIndex === 2 && typeof renderSlide1 === 'function') renderSlide1(); 
        if (slideIndex === 3 && typeof renderSlide2 === 'function') renderSlide2(); 
        if (slideIndex === 4 && typeof renderSlide3 === 'function') renderSlide3(); 
        if (slideIndex === 5 && typeof renderSlide4 === 'function') renderSlide4(); 
        if (slideIndex === 7 && typeof initCronograma === 'function') { setTimeout(() => { initCronograma(); }, 150); }
        if (slideIndex === 8 && typeof renderSlide7 === 'function') renderSlide7();
      }

      function getFilterDate(id, isEnd) {
         const val = document.getElementById(id).value; if(!val) return null;
         const parts = val.split('-'); const d = new Date(parts[0], parts[1]-1, parts[2]);
         if(isEnd) d.setHours(23, 59, 59, 999); else d.setHours(0,0,0,0); return d;
      }

      function getWeekData(d) {
         const date = new Date(d.getTime()); date.setHours(0,0,0,0); date.setDate(date.getDate() + 3 - (date.getDay() + 6) % 7);
         const week1 = new Date(date.getFullYear(), 0, 4); const weekNum = 1 + Math.round(((date.getTime() - week1.getTime()) / 86400000 - 3 + (week1.getDay() + 6) % 7) / 7);
         const curr = new Date(d.getTime()); const day = curr.getDay(); const diff = curr.getDate() - day + (day == 0 ? -6:1);
         const firstday = new Date(curr.setDate(diff)); const lastday = new Date(curr.setDate(curr.getDate()+4)); 
         return { num: weekNum, start: fmtDate(firstday), end: fmtDate(lastday) };
      }

      function parseDate(str) { if(!str) return new Date(0); const p = str.split('/'); return (p.length === 3) ? new Date(p[2], p[1]-1, p[0]) : new Date(str); }
      function fmtDate(d) { return `${d.getDate().toString().padStart(2, '0')}/${(d.getMonth()+1).toString().padStart(2, '0')}`; }
    </script>
  </body>
</html>