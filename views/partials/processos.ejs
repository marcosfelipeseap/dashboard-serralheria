<style>
  /* PADRÃO GLOBAL: Nomes e Textos */
  /* Reduz o tamanho da fonte, quebra apenas nos espaços e nunca separa sílabas */
  .texto-fluido {
      word-break: normal !important;
      overflow-wrap: normal !important;
      hyphens: none !important;
      white-space: normal !important;
      font-size: clamp(0.7rem, 2.5vw, 0.9rem) !important;
      line-height: 1.2 !important;
  }

  /* PADRÃO GLOBAL: Números e Quantidades */
  /* NUNCA quebra a linha. Força o número a encolher até caber perfeitamente */
  .numero-fluido {
      white-space: nowrap !important;
      word-break: keep-all !important;
      overflow-wrap: normal !important;
      font-size: clamp(0.65rem, 3vw, 1.1rem) !important; 
  }
  #slide5 { text-transform: uppercase; }
  .proc-table { width: 100%; border-collapse: collapse; background: var(--card-bg, #ffffff); font-size: 0.85rem; }
  .proc-table thead th {background: var(--accent) !important; color: white; padding: 12px; text-align: left; font-weight: 600; position: sticky; top: 0; z-index: 10; border: 1px solid var(--border-color);}
  .proc-row-header { cursor: pointer; border-bottom: 1px solid var(--border-color, #e0e0e0); transition: background 0.1s; }
  .proc-row-header:hover { background-color: var(--table-row-hover, #f5f5f5); }
  .proc-row-header.active {background-color: var(--input-bg); border-left: 4px solid var(--accent);}
  .proc-cell { padding: 8px 10px; border: 1px solid var(--border-color, #e0e0e0); color: var(--text-main, #333); vertical-align: middle; }

  .filters-container { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 15px; align-items: center; width: 100%;}
  .filters-container button {border-radius: 8px !important;}
  .custom-dropdown { position: relative; display: inline-block; flex: 1; min-width: 150px;}
  .drop-btn {background: var(--card-bg); border: 1px solid var(--border-color); padding: 12px 18px; border-radius: 12px; cursor: pointer; font-size: 0.95rem; color: var(--text-muted); font-weight: 500; display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; transition: 0.2s;}
  .drop-btn:hover { border-color: var(--accent, #1976d2); color: var(--accent, #1976d2); }
  .drop-btn.active-filter { background: var(--accent-light, #e3f2fd); color: var(--text-main, #333); border-color: var(--accent, #1976d2); }
  .dropdown-content {border-radius: 16px; border: none; box-shadow: var(--shadow);}
  .dropdown-content.show { display: block; animation: fadeIn 0.2s; }
  .drop-search { width: 100%; padding: 10px; margin-bottom: 8px; border: 1px solid var(--border-color, #e0e0e0); border-radius: 4px; font-size: 0.9rem; box-sizing: border-box; text-transform: uppercase; }
  .checkbox-item { display: flex; align-items: center; padding: 8px; cursor: pointer; font-size: 0.9rem; color: var(--text-main, #333); border-radius: 4px; }
  .checkbox-item:hover { background-color: var(--input-bg, #f5f5f5); }
  .checkbox-item input { margin-right: 10px; accent-color: var(--accent, #1976d2); width: 16px; height: 16px; }
  #globalSearch {padding: 12px 16px; border: 1px solid var(--border-color); border-radius: 12px; font-weight: 500;}

/* RESPONSIVIDADE E ESTILO DOS CARDS DE TOTAIS */
  .summary-cards { 
      display: flex; gap: 10px; margin-bottom: 20px; 
      flex-wrap: nowrap; /* Mantém os 3 na mesma linha */
      overflow-x: auto; /* Caso a tela seja minúscula, permite um leve deslize em vez de esmagar */
  }
  
  .summary-card {
      flex: 1; min-width: 0; 
      border-radius: 8px !important; 
      /* Paddings diminuem na tela pequena (mínimo 10px) e aumentam na tela grande (20px) */
      padding: clamp(10px, 2vw, 20px) clamp(5px, 1.5vw, 15px); 
      box-shadow: var(--shadow); 
      text-align: center;
      display: flex; flex-direction: column; justify-content: center;
      border: none !important;
  }
  
  .sc-title {font-size: clamp(0.65rem, 1.8vw, 0.95rem); font-weight: 800; margin-bottom: 8px; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;} 
  .sc-value {font-size: clamp(1.4rem, 4vw, 2.2rem); font-weight: 900; line-height: 1; }

  .sc-aut { background-color: var(--card-bg); border: 1px solid var(--border-color) !important; }
  .sc-aut .sc-title { color: var(--text-muted); }
  .sc-aut .sc-value { color: var(--accent); }

  .sc-ent { background-color: #2e7d32; color: white; }
  .sc-ent .sc-title { color: #c8e6c9; }
  .sc-ent .sc-value { color: white; }

  .sc-pend { background-color: #c62828; color: white; }
  .sc-pend .sc-title { color: #ffcdd2; }
  .sc-pend .sc-value { color: white; }

  .proc-row-details { display: none; }
  .proc-row-details.open { display: table-row; background: var(--input-bg, #f9f9f9); }
  .details-wrapper { padding: 15px; border: 1px solid var(--border-color, #e0e0e0); margin: 0; }

  .st-badge { padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; border: 1px solid transparent; }
  .st-verde { background: #e8f5e9; color: #2e7d32; border-color: #c8e6c9; }
  .st-amarelo { background: #fff3cd; color: #856404; border-color: #ffeeba; }
  .st-vermelho { background: #ffebee; color: #c62828; border-color: #ffcdd2; }
  .st-arquivado { background: #eceff1; color: #546e7a; border-color: #cfd8dc; }

  .termos-list { font-size: 0.8rem; margin-top: 10px; padding: 10px; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 6px; }
  .termos-list a { color: #1976d2; text-decoration: underline; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;}

  /* MANTÉM O FORMATO DE TABELA DO PC TAMBÉM NO MOBILE */
  @media (max-width: 1199px) {
      /* Devolve a caixa de rolagem horizontal nativa, permitindo arrastar para os lados */
      .stock-table-container { 
          height: 500px !important; 
          max-height: 70vh;
          overflow-x: auto !important; 
          overflow-y: auto !important;
          -webkit-overflow-scrolling: touch; /* Deixa o deslizar do dedo mais fluido */
          border: 1px solid var(--border-color) !important;
          border-radius: 8px;
          background: var(--card-bg);
      }
      
      /* Força a tabela a continuar sendo tabela e define largura mínima para evitar esmagamento */
      .proc-table { display: table !important; width: 100%; min-width: 950px; }
      .proc-table thead { display: table-header-group !important; }
      
      .proc-row-header { display: table-row !important; }
      
      .proc-cell { 
          display: table-cell !important; 
          text-align: center !important; 
          padding: 8px !important; 
          border-bottom: 1px solid var(--border-color) !important; 
          border-top: none !important;
          vertical-align: middle;
      }
      /* Mantém texto alinhado à esquerda para Processo, Tipo e Órgão */
      .proc-cell:nth-child(2), .proc-cell:nth-child(4), .proc-cell:nth-child(5) { 
          text-align: left !important; 
      }
      
      /* Garante que a linha de detalhes obedeça à tabela */
      .proc-row-details > td { display: table-cell !important; padding: 0 !important; }
      
      /* Limpa qualquer pseudo-texto residual do código antigo */
      .proc-cell::before, .details-wrapper table tbody td::before { display: none !important; }
      
      /* Restaura perfeitamente a subtabela interna de Materiais */
      .details-wrapper table { display: table !important; width: 100%; min-width: 850px; }
      .details-wrapper table thead { display: table-header-group !important; }
      .details-wrapper table tbody tr.mat-row { display: table-row !important; }
      .details-wrapper table tbody td { 
          display: table-cell !important; 
          text-align: center !important; 
          padding: 8px !important; 
          border-bottom: 1px dashed var(--border-color) !important; 
      }
      .details-wrapper table tbody td:nth-child(2), .details-wrapper table tbody td:nth-child(3), .details-wrapper table tbody td:nth-child(9) { 
          text-align: left !important; 
      }
  }
</style>

<div class="slide fade" id="slide5" style="display: none;">
  <div class="slide-header" style="padding-bottom: 10px; align-items: flex-start;">
    <div class="slide-title"><span class="material-icons">assignment</span> Controle de Processos</div>
    <div style="width: 100%; max-width: 400px;"><input type="text" id="globalSearch" placeholder="Pesquisa geral no processo..." onkeyup="applyAllFilters()"></div>
  </div>

  <div class="summary-cards">
    <div class="summary-card sc-aut"><div class="sc-title">TOTAL AUTORIZADO</div><div class="sc-value" id="card-aut">0</div></div>
    <div class="summary-card sc-ent"><div class="sc-title">TOTAL ENTREGUE</div><div class="sc-value" id="card-ent">0</div></div>
    <div class="summary-card sc-pend"><div class="sc-title">TOTAL PENDENTE</div><div class="sc-value" id="card-pend">0</div></div>
  </div>

  <div class="filters-container">
    <div class="custom-dropdown" id="dd-n_processo"><button class="drop-btn" onclick="toggleDropdown('n_processo')">N° PROCESSO <span class="material-icons" style="font-size:18px">arrow_drop_down</span></button><div class="dropdown-content" id="content-n_processo"></div></div>
    <div class="custom-dropdown" id="dd-tipo"><button class="drop-btn" onclick="toggleDropdown('tipo')">TIPO <span class="material-icons" style="font-size:18px">arrow_drop_down</span></button><div class="dropdown-content" id="content-tipo"></div></div>
    <div class="custom-dropdown" id="dd-orgao"><button class="drop-btn" onclick="toggleDropdown('orgao')">ÓRGÃO <span class="material-icons" style="font-size:18px">arrow_drop_down</span></button><div class="dropdown-content" id="content-orgao"></div></div>
    <div class="custom-dropdown" id="dd-material"><button class="drop-btn" onclick="toggleDropdown('material')">MATERIAL <span class="material-icons" style="font-size:18px">arrow_drop_down</span></button><div class="dropdown-content" id="content-material"></div></div>
    <div class="custom-dropdown" id="dd-status"><button class="drop-btn" onclick="toggleDropdown('status')">STATUS <span class="material-icons" style="font-size:18px">arrow_drop_down</span></button><div class="dropdown-content" id="content-status"></div></div>
    
    <div style="width: 100%; display: flex; gap: 10px;">
      <button onclick="clearAllFilters()" style="padding: 10px; border:none; background:var(--danger-bg); border-radius: 6px; color:var(--danger); cursor:pointer; font-size:0.8rem; font-weight:700; font-family: 'Poppins', sans-serif; display:flex; align-items:center; justify-content:center; gap:5px; flex: 1;">
        <span class="material-icons" style="font-size:18px; color:inherit;">filter_alt_off</span> LIMPAR FILTROS
      </button>
      <button onclick="exportProcessosExcel()" style="padding: 10px; border:none; background:#e8f5e9; border-radius: 6px; color:#2e7d32; cursor:pointer; font-size:0.8rem; font-weight:700; font-family: 'Poppins', sans-serif; display:flex; align-items:center; justify-content:center; gap:5px; flex: 1;">
        <span class="material-icons" style="font-size:18px; color:inherit;">table_view</span> EXCEL
      </button>
      <button onclick="exportProcessosPDF()" style="padding: 10px; border:none; background:#ffebee; border-radius: 6px; color:#c62828; cursor:pointer; font-size:0.8rem; font-weight:700; font-family: 'Poppins', sans-serif; display:flex; align-items:center; justify-content:center; gap:5px; flex: 1;">
        <span class="material-icons" style="font-size:18px; color:inherit;">picture_as_pdf</span> PDF
      </button>
    </div>
  </div>

  <div class="stock-table-container">
    <table class="proc-table">
      <thead>
        <tr>
          <th style="width:40px; text-align:center;"><input type="checkbox" id="master-cb-all" onchange="toggleAllProcs(this)" style="width:16px; height:16px; cursor:pointer;" title="Marcar/Desmarcar Todos"></th>
          <th>Processo</th>
          <th>Entrada</th>
          <th>Tipo</th>
          <th>Órgão</th>
          <th style="text-align:center">Autorizado</th>
          <th style="text-align:center">Total Autorizado</th>
          <th style="text-align:center">Entregue</th>
          <th style="text-align:center">Faltante</th>
          <th style="text-align:center">Status</th>
          <th style="width:30px"></th>
        </tr>
      </thead>
      <tbody id="processosTableBody"></tbody>
    </table>
  </div>
</div>

<script>
  let rawProcessos = []; let currentFiltered = []; let openRows = new Set(); 
  let activeFilters = { n_processo: [], tipo: [], orgao: [], material: [], status: [] };

  function receiveProcessosData(jsonString) {
    try {
      let data = JSON.parse(jsonString);
      rawProcessos = data.map((p, pIdx) => ({
        ...p, _uid: 'p_' + pIdx,
        itens: (p.itens || []).map((i, iIdx) => ({ ...i, _uid: 'i_' + pIdx + '_' + iIdx, _selected: true }))
      }));
      applyAllFilters();
    } catch (e) { console.error("Erro ao processar processos", e); }
  }

  function formatNumber(num) { const n = parseInt(num); return isNaN(n) ? '0' : n.toLocaleString('pt-BR'); }

  function sortProcessos(data) {
    const authOrder = { 'SIM': 1, 'N/A': 2, 'NÃO': 3, 'NAO': 3 };
    const statusOrder = { 'PARCIALMENTE ENTREGUE': 1, 'ENTREGA NÃO INICIADA': 2, 'ENTREGA NAO INICIADA': 2, 'DEMANDA CONCLUÍDA': 3, 'DEMANDA CONCLUIDA': 3, 'ENTREGUE': 3, 'ARQUIVADO': 4 };
    return data.sort((a, b) => {
      const authA = authOrder[ (a.autorizado||'').toUpperCase() ] || 99; const authB = authOrder[ (b.autorizado||'').toUpperCase() ] || 99;
      if (authA !== authB) return authA - authB;
      const statA = statusOrder[ (a.status||'').toUpperCase() ] || 99; const statB = statusOrder[ (b.status||'').toUpperCase() ] || 99;
      return statA - statB;
    });
  }

  function applyAllFilters() {
    const globalTerm = document.getElementById('globalSearch').value.toLowerCase(); let filtered = [];
    rawProcessos.forEach(p => {
      if (activeFilters.n_processo.length > 0 && !activeFilters.n_processo.includes(p.n_processo)) return;
      if (activeFilters.tipo.length > 0 && !activeFilters.tipo.includes(p.tipo)) return;
      if (activeFilters.orgao.length > 0 && !activeFilters.orgao.includes(p.orgao)) return;
      if (activeFilters.status.length > 0 && !activeFilters.status.includes(p.status)) return;

      let matchedItens = p.itens || [];
      if (activeFilters.material.length > 0) {
        matchedItens = matchedItens.filter(i => activeFilters.material.includes(i.material));
        if (matchedItens.length === 0) return; 
      }
      if (globalTerm) {
        let parentClone = { ...p, itens: [] };
        if (!JSON.stringify(parentClone).toLowerCase().includes(globalTerm)) {
          matchedItens = matchedItens.filter(i => JSON.stringify(i).toLowerCase().includes(globalTerm));
          if (matchedItens.length === 0) return;
        }
      }
      filtered.push({ ...p, itens: matchedItens });
    });
    currentFiltered = sortProcessos(filtered); renderTable(currentFiltered);
  }

 function renderTable(data) {
    const tbody = document.getElementById('processosTableBody');
    if (data.length === 0) { tbody.innerHTML = '<tr><td colspan="11" style="padding:20px; text-align:center">NENHUM REGISTRO ENCONTRADO.</td></tr>'; updateSummaryCards(); updateMasterCbAll(); return; }

    let html = '';
    data.forEach((p) => {
      let stBg = '#eceff1'; let stCol = '#546e7a'; // Padrão: Arquivado
      let stTxt = (p.status||'').toUpperCase();
      
      if (stTxt.includes('PARCIAL')) { 
          stBg = '#fff3cd'; stCol = '#856404'; 
      } else if (stTxt.includes('CONCLUÍDA') || stTxt.includes('ENTREGUE')) { 
          stBg = '#e8f5e9'; stCol = '#2e7d32'; 
      } else if (stTxt.includes('NÃO INICIADA') || stTxt.includes('NAO INICIADA')) { 
          stBg = '#ffebee'; stCol = '#c62828';}

      let allItemsChecked = p.itens.length > 0 && p.itens.every(i => i._selected); let isOpen = openRows.has(p._uid);
      const processDisplayHtml = p.link_sei ? `<a href="${p.link_sei}" target="_blank" onclick="event.stopPropagation();" style="color: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;" title="Abrir processo no SEI"><span style="text-decoration: underline;">${p.n_processo}</span><span class="material-icons" style="font-size: 14px; text-decoration: none;">open_in_new</span></a>` : p.n_processo;

      let procAutTotal = p.itens.reduce((sum, i) => sum + (Number(i.qtd_aut) || 0), 0);
      let procEntTotal = p.itens.reduce((sum, i) => sum + (Number(i.qtd_ent) || 0), 0);
      let procFaltTotal = p.itens.reduce((sum, i) => sum + (Number(i.qtd_falt) || 0), 0);

      let termosHtml = '';
      if(p.termos && p.termos.length > 0) {
         termosHtml = `<div class="termos-list"><strong>TERMOS DESTE PROCESSO:</strong><ul style="margin:5px 0; padding-left:20px;">`;
         p.termos.forEach(t => {
            let link = t.pdf ? `<a href="${t.pdf}" target="_blank">${t.num} <span class="material-icons" style="font-size:14px">picture_as_pdf</span></a>` : t.num;
            termosHtml += `<li>${link} - ${t.situacao} (${t.data})</li>`;
         });
         termosHtml += `</ul></div>`;
      }

      html += `
        <tr class="proc-row-header ${isOpen ? 'active' : ''}" id="pr-${p._uid}">
          <td class="proc-cell" style="text-align:center" onclick="event.stopPropagation();"><input type="checkbox" class="proc-cb" onchange="toggleProc('${p._uid}', this)" ${allItemsChecked ? 'checked' : ''} style="width:16px; height:16px; cursor:pointer;"></td>
          <td class="proc-cell" onclick="toggleRow('${p._uid}')" style="font-weight:600; color:var(--accent, #1976d2)"><span class="texto-fluido">${processDisplayHtml}</span></td>
          <td class="proc-cell" onclick="toggleRow('${p._uid}')"><strong><span class="numero-fluido">${p.data_entrada}</span></strong></td>
          <td class="proc-cell" onclick="toggleRow('${p._uid}')"><span class="texto-fluido">${p.tipo}</span></td>
          <td class="proc-cell" onclick="toggleRow('${p._uid}')"><span class="texto-fluido">${p.orgao}</span></td>
          <td class="proc-cell" onclick="toggleRow('${p._uid}')" style="text-align:center"><span class="texto-fluido">${p.autorizado}</span></td>
          <td class="proc-cell" onclick="toggleRow('${p._uid}')" style="text-align:center; font-weight:bold"><span class="numero-fluido">${formatNumber(procAutTotal)}</span></td>
          <td class="proc-cell" onclick="toggleRow('${p._uid}')" style="text-align:center; color:var(--success, #2e7d32); font-weight:bold"><span class="numero-fluido">${formatNumber(procEntTotal)}</span></td>
          <td class="proc-cell" onclick="toggleRow('${p._uid}')" style="text-align:center; color:var(--danger, #c62828); font-weight:bold"><span class="numero-fluido">${formatNumber(procFaltTotal)}</span></td>
          <td class="proc-cell" onclick="toggleRow('${p._uid}')" style="text-align:center; background-color: ${stBg}; color: ${stCol}; font-weight: 700; border: 1px solid ${stBg}; border-bottom: 1px solid var(--border-color);"><span class="texto-fluido">${p.status}</span></td>
          <td class="proc-cell" onclick="toggleRow('${p._uid}')" style="text-align:center"><span class="material-icons expand-btn" style="font-size:18px; color:#999">${isOpen ? 'expand_less' : 'expand_more'}</span></td>
        </tr>
        <tr class="proc-row-details ${isOpen ? 'open' : ''}" id="pd-${p._uid}">
          <td colspan="11" style="padding:0;">
            <div class="details-wrapper">
               <table style="width:100%; font-size:0.85rem; border-collapse: collapse;">
                  <thead style="background:var(--input-bg); color:var(--text-muted);">
                     <tr>
                        <th style="width:40px; text-align:center;"><input type="checkbox" class="mat-master-cb" onchange="toggleAllMaterials('${p._uid}', this)" ${allItemsChecked ? 'checked' : ''} style="width:14px; height:14px; cursor:pointer;"></th>
                        <th>Material</th><th>Subgrupo</th><th style="text-align:center">Qtd Aut</th><th style="text-align:center">Entregue</th><th style="text-align:center">Faltante</th><th>Prazo</th><th>Situação</th><th>Obs</th>
                     </tr>
                  </thead>
                  <tbody>
                    ${p.itens.map(i => `
                      <tr class="mat-row" id="tr-${i._uid}" style="border-bottom:1px dashed var(--border-color); transition: opacity 0.2s; opacity: ${i._selected ? '1' : '0.4'};">
                        <td style="padding:8px; text-align:center;"><input type="checkbox" class="mat-cb" onchange="toggleMaterial('${p._uid}', '${i._uid}', this)" ${i._selected ? 'checked' : ''} style="width:14px; height:14px; cursor:pointer;"></td>
                        <td style="padding:8px; font-weight:bold"><span class="texto-fluido">${i.material}</span></td>
                        <td style="padding:8px;"><span class="texto-fluido">${i.subgrupo}</span></td>
                        <td style="padding:8px; text-align:center; font-weight:bold"><span class="numero-fluido">${formatNumber(i.qtd_aut)}</span></td>
                        <td style="padding:8px; text-align:center; color:var(--success); font-weight:bold"><span class="numero-fluido">${formatNumber(i.qtd_ent)}</span></td>
                        <td style="padding:8px; text-align:center; color:var(--danger); font-weight:bold"><span class="numero-fluido">${formatNumber(i.qtd_falt)}</span></td>
                        <td style="padding:8px;"><span class="numero-fluido">${i.prazo}</span></td>
                        <td style="padding:8px;"><span class="texto-fluido">${i.situacao}</span></td>
                        <td style="padding:8px; font-style:italic; color:var(--text-muted)"><span class="texto-fluido">${i.observacao}</span></td>
                      </tr>`).join('')}
                  </tbody>
               </table>
               ${termosHtml}
            </div>
          </td>
        </tr>
      `;
    });
    tbody.innerHTML = html; updateSummaryCards(); updateMasterCbAll();
  }

  function updateSummaryCards() {
    let totalAut = 0, totalEnt = 0, totalPend = 0;
    currentFiltered.forEach(p => { p.itens.forEach(i => { if (i._selected) { totalAut += Number(i.qtd_aut) || 0; totalEnt += Number(i.qtd_ent) || 0; totalPend += Number(i.qtd_falt) || 0; } }); });
    document.getElementById('card-aut').textContent = formatNumber(totalAut); document.getElementById('card-ent').textContent = formatNumber(totalEnt); document.getElementById('card-pend').textContent = formatNumber(totalPend);
  }

  function updateMasterCbAll() {
    let master = document.getElementById('master-cb-all'); if(!master) return;
    if(currentFiltered.length === 0) { master.checked = false; return; }
    master.checked = currentFiltered.every(p => p.itens.every(i => i._selected));
  }

  function toggleAllProcs(checkbox) {
    let isChecked = checkbox.checked; currentFiltered.forEach(p => { p.itens.forEach(i => i._selected = isChecked); });
    document.querySelectorAll('.proc-cb, .mat-master-cb, .mat-cb').forEach(cb => cb.checked = isChecked);
    document.querySelectorAll('.mat-row').forEach(tr => tr.style.opacity = isChecked ? '1' : '0.4');
    updateSummaryCards();
  }

  function toggleProc(procUid, checkbox) {
    let isChecked = checkbox.checked; let p = currentFiltered.find(x => x._uid === procUid);
    if(p) { p.itens.forEach(i => i._selected = isChecked); }
    let detailRow = document.getElementById(`pd-${procUid}`);
    if(detailRow) { detailRow.querySelectorAll('.mat-cb, .mat-master-cb').forEach(cb => cb.checked = isChecked); detailRow.querySelectorAll('.mat-row').forEach(tr => tr.style.opacity = isChecked ? '1' : '0.4'); }
    updateMasterCbAll(); updateSummaryCards();
  }

  function toggleAllMaterials(procUid, checkbox) { let procCb = document.querySelector(`#pr-${procUid} .proc-cb`); if(procCb) procCb.checked = checkbox.checked; toggleProc(procUid, checkbox); }

  function toggleMaterial(procUid, itemUid, checkbox) {
    let isChecked = checkbox.checked; let p = currentFiltered.find(x => x._uid === procUid);
    if(p) { let item = p.itens.find(x => x._uid === itemUid); if(item) item._selected = isChecked; let allChecked = p.itens.every(i => i._selected); let procCb = document.querySelector(`#pr-${procUid} .proc-cb`); let matMasterCb = document.querySelector(`#pd-${procUid} .mat-master-cb`); if(procCb) procCb.checked = allChecked; if(matMasterCb) matMasterCb.checked = allChecked; }
    let matRow = document.getElementById(`tr-${itemUid}`); if(matRow) matRow.style.opacity = isChecked ? '1' : '0.4';
    updateMasterCbAll(); updateSummaryCards();
  }

  function toggleRow(uid) {
    const row = document.getElementById(`pd-${uid}`); const head = document.getElementById(`pr-${uid}`);
    if (!row) return;
    if (row.classList.contains('open')) { row.classList.remove('open'); head.classList.remove('active'); head.querySelector('.expand-btn').textContent = 'expand_more'; openRows.delete(uid); } 
    else { row.classList.add('open'); head.classList.add('active'); head.querySelector('.expand-btn').textContent = 'expand_less'; openRows.add(uid); }
  }

  function toggleDropdown(key) {
    document.querySelectorAll('.dropdown-content').forEach(el => { if(el.id !== `content-${key}`) el.classList.remove('show'); });
    const content = document.getElementById(`content-${key}`);
    if (!content.classList.contains('show')) { populateDropdownOptions(key); content.classList.add('show'); } else { content.classList.remove('show'); }
  }

  window.onclick = function(event) { if (!event.target.matches('.drop-btn') && !event.target.closest('.dropdown-content')) { document.querySelectorAll('.dropdown-content').forEach(el => el.classList.remove('show')); } }

  function populateDropdownOptions(key) {
    const content = document.getElementById(`content-${key}`); content.innerHTML = `<input type="text" class="drop-search" placeholder="BUSCAR..." onkeyup="filterDropdownList(this)">`;
    let cascadeData = rawProcessos.filter(p => {
       if (key !== 'n_processo' && activeFilters.n_processo.length > 0 && !activeFilters.n_processo.includes(p.n_processo)) return false;
       if (key !== 'tipo' && activeFilters.tipo.length > 0 && !activeFilters.tipo.includes(p.tipo)) return false;
       if (key !== 'orgao' && activeFilters.orgao.length > 0 && !activeFilters.orgao.includes(p.orgao)) return false;
       if (key !== 'status' && activeFilters.status.length > 0 && !activeFilters.status.includes(p.status)) return false;
       return true;
    });

    const uniqueSet = new Set();
    cascadeData.forEach(p => { if (key === 'material') { if (p.itens && Array.isArray(p.itens)) { p.itens.forEach(i => { if (i.material) uniqueSet.add(i.material.trim()); }); } } else { const val = p[key]; if (val) uniqueSet.add(val.toString().trim()); } });

    const sortedOptions = Array.from(uniqueSet).sort();
    if (sortedOptions.length === 0) { const div = document.createElement('div'); div.style.padding = "8px"; div.style.color = "#999"; div.style.fontStyle = "italic"; div.innerText = "SEM OPÇÕES"; content.appendChild(div); return; }
    sortedOptions.forEach(val => {
      const isChecked = activeFilters[key].includes(val) ? 'checked' : ''; const div = document.createElement('div'); div.className = 'checkbox-item';
      div.innerHTML = `<label style="width:100%; cursor:pointer; display:flex; align-items:center;"><input type="checkbox" value="${val}" ${isChecked} onchange="updateFilterState('${key}', this)"> <span style="margin-left: 8px;">${val}</span></label>`;
      content.appendChild(div);
    });
  }

  function filterDropdownList(input) { const filter = input.value.toLowerCase(); const items = input.parentElement.getElementsByClassName('checkbox-item'); for (let i = 0; i < items.length; i++) { let txt = items[i].textContent || items[i].innerText; items[i].style.display = txt.toLowerCase().indexOf(filter) > -1 ? "" : "none"; } }

  function updateFilterState(key, checkbox) {
    const val = checkbox.value; if (checkbox.checked) { activeFilters[key].push(val); } else { activeFilters[key] = activeFilters[key].filter(v => v !== val); }
    const btn = document.querySelector(`#dd-${key} .drop-btn`); if(activeFilters[key].length > 0) btn.classList.add('active-filter'); else btn.classList.remove('active-filter'); applyAllFilters();
  }

  function clearAllFilters() { activeFilters = { n_processo: [], tipo: [], orgao: [], material: [], status: [] }; document.querySelectorAll('.drop-btn').forEach(b => b.classList.remove('active-filter')); document.getElementById('globalSearch').value = ''; applyAllFilters(); }

  // ----------------------------------------------------
  // FUNÇÕES DE EXPORTAÇÃO PARA EXCEL E PDF 
  // ----------------------------------------------------
  function exportProcessosExcel() {
    if(currentFiltered.length === 0) return alert("Nenhum registro para exportar.");
    
    let exportData = [];
    currentFiltered.forEach(p => {
      if(p.itens && p.itens.length > 0) {
        p.itens.forEach(i => {
          exportData.push({
            "PROCESSO": p.n_processo,
            "ENTRADA": p.data_entrada,
            "TIPO": p.tipo,
            "ÓRGÃO": p.orgao,
            "AUTORIZADO": p.autorizado,
            "STATUS PROCESSO": p.status,
            "MATERIAL": i.material,
            "SUBGRUPO": i.subgrupo,
            "QTD AUT": Number(i.qtd_aut) || 0,
            "ENTREGUE": Number(i.qtd_ent) || 0,
            "FALTANTE": Number(i.qtd_falt) || 0,
            "PRAZO": i.prazo,
            "SITUAÇÃO ITEM": i.situacao,
            "OBSERVAÇÃO": i.observacao || ""
          });
        });
      } else {
        exportData.push({
          "PROCESSO": p.n_processo,
          "ENTRADA": p.data_entrada,
          "TIPO": p.tipo,
          "ÓRGÃO": p.orgao,
          "AUTORIZADO": p.autorizado,
          "STATUS PROCESSO": p.status,
          "MATERIAL": "-",
          "SUBGRUPO": "-",
          "QTD AUT": 0,
          "ENTREGUE": 0,
          "FALTANTE": 0,
          "PRAZO": "-",
          "SITUAÇÃO ITEM": "-",
          "OBSERVAÇÃO": "-"
        });
      }
    });

    const ws = XLSX.utils.json_to_sheet(exportData);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, "Processos");
    XLSX.writeFile(wb, "Processos_Filtrados.xlsx");
  }

  function exportProcessosPDF() {
    if(currentFiltered.length === 0) return alert("Nenhum registro para exportar.");
    
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF('landscape');

    doc.setFontSize(14);
    doc.text("Relatório de Processos (Filtrados)", 14, 15);
    doc.setFontSize(10);
    doc.text("Gerado em: " + new Date().toLocaleString('pt-BR'), 14, 22);

    let bodyData = [];
    currentFiltered.forEach(p => {
      if(p.itens && p.itens.length > 0) {
        p.itens.forEach(i => {
          bodyData.push([
            p.n_processo, 
            p.data_entrada, 
            p.orgao, 
            i.material, 
            (Number(i.qtd_aut)||0).toString(), 
            (Number(i.qtd_ent)||0).toString(), 
            (Number(i.qtd_falt)||0).toString(), 
            p.status
          ]);
        });
      } else {
        bodyData.push([
          p.n_processo, 
          p.data_entrada, 
          p.orgao, 
          "-", 
          "0", 
          "0", 
          "0", 
          p.status
        ]);
      }
    });

    doc.autoTable({
      startY: 28,
      head: [['Processo', 'Entrada', 'Órgão', 'Material', 'Qtd Aut', 'Entregue', 'Falt', 'Status']],
      body: bodyData,
      theme: 'grid',
      styles: { fontSize: 8 },
      headStyles: { fillColor: [69, 90, 100] } // Cor padrão var(--accent) do dashboard
    });

    doc.save("Processos_Filtrados.pdf");
  }
</script>